---
interface Props {
  tipo: string;
  ejemplos: Array<{nombre: string; simbolos: string[]; esperado: boolean}>;
}

const { tipo, ejemplos } = Astro.props;
const tituloMap = {
  ciberseguridad: 'Ciberseguridad (TCP 3-way Handshake)',
  iot: 'Lecturas IoT (HDR...CRC)',
  ecommerce: 'E-commerce (Flujo de compra)'
};
---

<div class="automata-card">
  <h2>{tituloMap[tipo]}</h2>
  
  <div class="content">
    <div class="form-section">
      <h3>🔍 Validación Personalizada</h3>
      <form id={`form-${tipo}`} class="form">
        <input
          type="text"
          id={`input-${tipo}`}
          placeholder="Ej: SYN,ACK,RST"
          required
        />
        <button type="submit" class="btn-submit">Validar</button>
      </form>
    </div>
    
    <div class="ejemplos-section">
      <h3>📋 Ejemplos Predefinidos</h3>
      <div class="ejemplos-grid">
        {ejemplos.map((ej) => (
          <button
            class={`ejemplo-btn ${ej.esperado ? 'aceptacion' : 'rechazo'}`}
            data-tipo={tipo}
            data-simbolos={ej.simbolos.join(',')}
            data-nombre={ej.nombre}
          >
            <span class="badge">{ej.esperado ? '✅' : '❌'}</span>
            <span>{ej.nombre}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
  
  <div id={`resultado-${tipo}`} class="resultado-section"></div>
</div>
<script define:vars={{tipo}}>
  const form = document.getElementById(`form-${tipo}`);
  const resultadoDiv = document.getElementById(`resultado-${tipo}`);
  const input = document.getElementById(`input-${tipo}`);

  // Validar con formulario
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const simbolos = input.value
      .split(',')
      .map(s => s.trim())
      .filter(s => s.length > 0);

    if (simbolos.length === 0) {
      mostrarError('Por favor ingresa símbolos válidos');
      return;
    }

    await validarYMostrar(simbolos, input.value);
  });

  // Validar con ejemplos
  document.querySelectorAll(`.ejemplo-btn[data-tipo="${tipo}"]`).forEach(btn => {
    btn.addEventListener('click', async () => {
      const simbolos = btn.dataset.simbolos.split(',');
      const nombre = btn.dataset.nombre;
      await validarYMostrar(simbolos, nombre);
    });
  });

  async function validarYMostrar(simbolos, label) {
    resultadoDiv.innerHTML = '<div class="loading"><div class="spinner"></div><span>⏳ Validando cadena...</span></div>';

    try {
      const response = await fetch(`http://localhost:8080/api/automatas/${tipo}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(simbolos)
      });

      if (!response.ok) {
        mostrarError(`Error ${response.status}`);
        return;
      }

      const data = await response.json();
      mostrarResultado(data, label, simbolos);
    } catch (error) {
      mostrarError(error.message);
    }
  }

  function mostrarError(msg) {
    resultadoDiv.innerHTML = `<div class="error-msg">⚠️ ${msg}</div>`;
  }

  function mostrarResultado(data, label, simbolos) {
    const cadena = simbolos.join(' → ');
    const coinciden = data.validoAFN === data.validoAFDTransformado && data.validoAFDTransformado === data.validoAFDMinimizado;
    
    const html = `
      <div class="resultado-content">
        <div class="cadena-info ${data.validoAFN ? 'aceptada' : 'rechazada'}">
          <div class="cadena-header">
            <h4>Cadena: <span class="font-mono">${cadena}</span></h4>
            <span class="resultado-badge ${data.validoAFN ? 'valida' : 'invalida'}">
              ${data.validoAFN ? '✅ ACEPTADA' : '❌ RECHAZADA'}
            </span>
          </div>
          <p class="cadena-label">${label}</p>
        </div>
        
        <div class="animacion-autómata">
          ${generarAnimacionAutomata(simbolos, data.validoAFN)}
        </div>
        
        <div class="validaciones">
          <div class="val-item ${data.validoAFN ? 'valido' : 'invalido'}">
            <span class="icon">${data.validoAFN ? '✅' : '❌'}</span>
            <div class="val-content">
              <strong>AFN</strong>
              <span>${data.validoAFN ? 'Aceptada' : 'Rechazada'}</span>
            </div>
          </div>
          <div class="val-item ${data.validoAFDTransformado ? 'valido' : 'invalido'}">
            <span class="icon">${data.validoAFDTransformado ? '✅' : '❌'}</span>
            <div class="val-content">
              <strong>AFD Transformado</strong>
              <span>${data.validoAFDTransformado ? 'Aceptada' : 'Rechazada'}</span>
            </div>
          </div>
          <div class="val-item ${data.validoAFDMinimizado ? 'valido' : 'invalido'}">
            <span class="icon">${data.validoAFDMinimizado ? '✅' : '❌'}</span>
            <div class="val-content">
              <strong>AFD Minimizado</strong>
              <span>${data.validoAFDMinimizado ? 'Aceptada' : 'Rechazada'}</span>
            </div>
          </div>
        </div>
        
        <div class="consistency ${coinciden ? 'ok' : 'warning'}">
          <span class="icon">${coinciden ? '✓' : '⚠'}</span>
          <span>${coinciden ? 'Todos los autómatas coinciden en el resultado' : 'Los autómatas no coinciden en el resultado'}</span>
        </div>
        
        <details class="tablas-container">
          <summary>📊 Ver Tablas de Transiciones</summary>
          <div class="tablas">
            ${mostrarTabla(data.afn, 'AFN')}
            ${mostrarTabla(data.afdTransformado, 'AFD Transformado')}
            ${mostrarTabla(data.afdMinimizado, 'AFD Minimizado')}
          </div>
        </details>
      </div>
    `;
    resultadoDiv.innerHTML = html;
  }

  function generarAnimacionAutomata(simbolos, esValida) {
    let html = '<div class="automata-trace"><h4>🤖 Visualización del Autómata</h4>';
    
    // SVG Canvas para el diagrama mejorado
    html += '<svg class="automata-graph" viewBox="0 0 900 500" xmlns="http://www.w3.org/2000/svg">';
    
    // Definir estilos y marcadores
    html += `
      <defs>
        <marker id="arrowGreen" markerWidth="12" markerHeight="12" refX="11" refY="6" orient="auto">
          <polygon points="0 0, 12 6, 0 12" fill="#4caf50" />
        </marker>
        <marker id="arrowRed" markerWidth="12" markerHeight="12" refX="11" refY="6" orient="auto">
          <polygon points="0 0, 12 6, 0 12" fill="#f44336" />
        </marker>
        <marker id="arrowBlue" markerWidth="12" markerHeight="12" refX="11" refY="6" orient="auto">
          <polygon points="0 0, 12 6, 0 12" fill="#667eea" />
        </marker>
        <style>
          .automata-path { fill: none; stroke-width: 2; }
          .path-green { stroke: #4caf50; }
          .path-blue { stroke: #667eea; opacity: 0.4; }
          .path-red { stroke: #f44336; }
        </style>
      </defs>
    `;
    
    // Posiciones de estados (layout similar a la imagen)
    const positions = {
      'q0': { x: 450, y: 50 },
      'q1': { x: 150, y: 200 },
      'q2': { x: 450, y: 300 },
      'q3': { x: 750, y: 200 },
      'q_fallo': { x: 450, y: 450 }
    };
    
    // Rastrear el camino recorrido
    let estadoActual = 'q0';
    const camino = ['q0'];
    
    for (let i = 0; i < simbolos.length; i++) {
      const nuevoEstado = 'q' + Math.min(i + 1, 3);
      camino.push(nuevoEstado);
      estadoActual = nuevoEstado;
    }
    
    // Dibujar transiciones como arcos
    const transiciones = [
      { from: 'q0', to: 'q1', label: 'SYN/A' },
      { from: 'q0', to: 'q2', label: 'D' },
      { from: 'q0', to: 'q3', label: 'R' },
      { from: 'q1', to: 'q2', label: 'ACK' },
      { from: 'q1', to: 'q0', label: 'SYN' },
      { from: 'q2', to: 'q3', label: 'RST' },
      { from: 'q3', to: 'q0', label: 'SYN' },
      { from: 'q0', to: 'q_fallo', label: 'ERR' },
    ];
    
    transiciones.forEach(trans => {
      const from = positions[trans.from];
      const to = positions[trans.to];
      
      // Determinar si esta transición está en el camino
      const indiceFrom = camino.indexOf(trans.from);
      const indiceTo = camino.indexOf(trans.to);
      const enCamino = indiceFrom !== -1 && indiceTo === indiceFrom + 1;
      
      // Calcular puntos de control para bezier
      const dx = to.x - from.x;
      const dy = to.y - from.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      
      const perpX = -dy / dist * 40;
      const perpY = dx / dist * 40;
      
      const cp1x = from.x + dx/2 + perpX;
      const cp1y = from.y + dy/2 + perpY;
      
      const clase = enCamino ? (esValida ? 'path-green' : 'path-red') : 'path-blue';
      const marker = enCamino ? (esValida ? 'url(#arrowGreen)' : 'url(#arrowRed)') : 'url(#arrowBlue)';
      
      html += `
        <path class="automata-path ${clase}" 
              d="M ${from.x} ${from.y} Q ${cp1x} ${cp1y} ${to.x} ${to.y}"
              marker-end="${marker}" />
        <text x="${cp1x - 15}" y="${cp1y - 5}" class="transicion-label">${trans.label}</text>
      `;
    });
    
    // Dibujar nodos de estados
    Object.entries(positions).forEach(([estado, pos]) => {
      const isInicial = estado === 'q0';
      const esActual = estado === estadoActual;
      const enCamino = camino.includes(estado);
      
      let fillColor = '#f0f4ff';
      let strokeColor = '#667eea';
      let strokeWidth = 2;
      
      if (isInicial) {
        fillColor = '#e8f5e9';
        strokeColor = '#4caf50';
        strokeWidth = 3;
      } else if (esActual && enCamino) {
        fillColor = '#fff9c4';
        strokeColor = '#fbc02d';
        strokeWidth = 3;
      } else if (enCamino && esValida) {
        fillColor = '#c8e6c9';
        strokeColor = '#4caf50';
        strokeWidth = 2;
      } else if (estado === 'q_fallo' && !esValida && enCamino) {
        fillColor = '#ffcdd2';
        strokeColor = '#f44336';
        strokeWidth = 3;
      }
      
      html += `
        <g class="estado-nodo">
          <circle cx="${pos.x}" cy="${pos.y}" r="35" fill="${fillColor}" stroke="${strokeColor}" stroke-width="${strokeWidth}" />
          <text x="${pos.x}" y="${pos.y}" class="nodo-text">${estado}</text>
      `;
      
      if (isInicial) {
        html += `<line x1="${pos.x - 50}" y1="${pos.y}" x2="${pos.x - 35}" y2="${pos.y}" stroke="#4caf50" stroke-width="2" marker-end="url(#arrowGreen)" />`;
      }
      
      html += `</g>`;
    });
    
    html += '</svg>';
    
    // Panel de ejecución paso a paso
    html += '<div class="ejecucion-pasos"><h5>📝 Pasos de Ejecución:</h5>';
    html += '<div class="pasos-list">';
    html += '<div class="paso-item inicial-paso"><strong>🔵 Estado Inicial:</strong> <span class="paso-estado">q0</span></div>';
    
    let estadoExec = 'q0';
    simbolos.forEach((simbolo, idx) => {
      const nuevoEstado = 'q' + Math.min(idx + 1, 3);
      const claseTransicion = (esValida || idx < simbolos.length - 1) ? 'transicion-valida' : (esValida ? 'transicion-valida' : 'transicion-neutra');
      html += `
        <div class="paso-item ${claseTransicion}">
          <span class="paso-numero">${idx + 1}.</span>
          <span class="paso-simbolo">${simbolo}</span>
          <span class="paso-flecha">→</span>
          <span class="paso-estado">${nuevoEstado}</span>
        </div>
      `;
      estadoExec = nuevoEstado;
    });
    
    const claseFinal = esValida ? 'aceptacion-paso' : 'rechazo-paso';
    const iconoFinal = esValida ? '✅' : '⛔';
    html += `
      <div class="paso-item ${claseFinal}">
        <strong>${iconoFinal} Resultado Final:</strong>
        <span class="paso-resultado">${esValida ? 'ACEPTADA' : 'RECHAZADA'}</span>
      </div>
    `;
    
    html += '</div></div>';
    html += '</div>';
    
    return html;
  }

  function mostrarTabla(automata, nombre) {
    const rows = Object.entries(automata.tablaTransiciones || {})
      .map(([estado, transiciones]) => {
        const transicionesCells = Object.entries(transiciones || {})
          .map(([simbolo, destino]) => `<span class="trans">${simbolo}→${destino}</span>`)
          .join('');
        
        const isAceptacion = automata.estadosAceptacion && automata.estadosAceptacion.includes(estado);
        return `
          <tr>
            <td class="estado-cell ${isAceptacion ? 'aceptacion' : ''}">
              ${estado} ${isAceptacion ? '✓' : ''}
            </td>
            <td>${transicionesCells || 'N/A'}</td>
          </tr>
        `;
      })
      .join('');

    return `
      <div class="tabla-wrapper">
        <h4>${nombre}</h4>
        <div class="meta-info">
          <span>Estados: <code>${automata.estados ? automata.estados.length : 0}</code></span>
          <span>Inicial: <code>${automata.estadoInicial || 'N/A'}</code></span>
        </div>
        <table>
          <thead>
            <tr><th>Estado</th><th>Transiciones</th></tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
    `;
  }
</script>

<style>
  .automata-card {
    background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%);
    border-radius: 15px;
    padding: 35px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    margin-bottom: 35px;
    border: 2px solid #e8eaff;
    transition: all 0.3s ease;
  }

  .automata-card:hover {
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.12);
    border-color: #d0d5ff;
  }
  
  h2 {
    color: #1a202c;
    margin-bottom: 30px;
    font-size: 1.8rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    padding-bottom: 12px;
    border-bottom: 3px solid #e8eaff;
  }
  
  h3 {
    color: #2d3748;
    font-size: 1.15rem;
    margin-bottom: 18px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 35px;
  }

  @media (max-width: 1024px) {
    .content {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  }
  
  .form-section, .ejemplos-section {
    display: flex;
    flex-direction: column;
  }
  
  .form {
    display: flex;
    gap: 12px;
    width: 100%;
  }
  
  input {
    flex: 1;
    padding: 14px 18px;
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    font-size: 1rem;
    font-family: 'Courier New', monospace;
    transition: all 0.3s;
    background: white;
  }
  
  input:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
    background: #f8faff;
  }
  
  .btn-submit {
    padding: 14px 32px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
    white-space: nowrap;
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
  }
  
  .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
  }

  .btn-submit:active {
    transform: translateY(0);
  }
  
  .ejemplos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
  }
  
  .ejemplo-btn {
    padding: 16px 12px;
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    background: white;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .badge {
    font-size: 1.4rem;
  }
  
  .ejemplo-btn.aceptacion {
    border-color: #4caf50;
    background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
    color: #2e7d32;
    box-shadow: 0 4px 12px rgba(76, 175, 80, 0.15);
  }

  .ejemplo-btn.rechazo {
    border-color: #f44336;
    background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
    color: #c62828;
    box-shadow: 0 4px 12px rgba(244, 67, 54, 0.15);
  }
  
  .ejemplo-btn:hover {
    transform: translateY(-3px);
  }

  .resultado-section {
    width: 100%;
  }

  .loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 60px 20px;
    font-size: 1.1rem;
    color: #667eea;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #e8eaff;
    border-top: 4px solid #667eea;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .error-msg {
    background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
    color: #c62828;
    padding: 20px;
    border-radius: 10px;
    border-left: 5px solid #f44336;
    font-weight: 600;
  }

  .resultado-content {
    animation: slideIn 0.4s ease;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cadena-info {
    padding: 25px;
    border-radius: 12px;
    margin-bottom: 25px;
    border: 2px solid;
    background: linear-gradient(135deg, #f0f4ff 0%, #e8f0ff 100%);
    border-color: #667eea;
  }

  .cadena-info.aceptada {
    background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
    border-color: #4caf50;
  }

  .cadena-info.rechazada {
    background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
    border-color: #f44336;
  }

  .cadena-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .cadena-info h4 {
    margin: 0;
    font-size: 1.2rem;
    color: #1a202c;
  }

  .font-mono {
    font-family: 'Courier New', monospace;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.6);
    padding: 4px 10px;
    border-radius: 6px;
  }

  .resultado-badge {
    padding: 8px 16px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .resultado-badge.valida {
    background: #4caf50;
    color: white;
    box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3);
  }

  .resultado-badge.invalida {
    background: #f44336;
    color: white;
    box-shadow: 0 4px 12px rgba(244, 67, 54, 0.3);
  }

  .cadena-label {
    margin: 0;
    font-size: 0.95rem;
    color: #1a202c;
    font-weight: 600;
  }

  .animacion-autómata {
    margin-bottom: 30px;
    background: white;
    padding: 25px;
    border-radius: 12px;
    border: 2px solid #e8eaff;
  }

  .automata-trace h4 {
    margin: 0 0 20px 0;
    color: #2d3748;
    font-size: 1.1rem;
  }

  .automata-graph {
    width: 100%;
    max-width: 900px;
    height: 450px;
    background: linear-gradient(135deg, #0f1419 0%, #1a1f2e 100%);
    border: 2px solid #e8eaff;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  .transicion-line {
    stroke: #667eea;
    stroke-width: 2;
    opacity: 0.3;
  }

  .transicion-label {
    font-family: 'Courier New', monospace;
    font-size: 12px;
    font-weight: 700;
    fill: #667eea;
    text-anchor: middle;
  }

  .estado-nodo {
    transition: all 0.3s ease;
  }

  .nodo-circle {
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
  }

  .nodo-text {
    font-family: 'Courier New', monospace;
    font-weight: 700;
    font-size: 16px;
    text-anchor: middle;
    dominant-baseline: middle;
    fill: #1a202c;
  }

  .ejecucion-pasos {
    background: linear-gradient(135deg, #f8f9ff 0%, #f0f4ff 100%);
    padding: 20px;
    border-radius: 8px;
    border: 2px solid #e8eaff;
  }

  .ejecucion-pasos h5 {
    margin: 0 0 15px 0;
    color: #2d3748;
    font-size: 1rem;
  }

  .pasos-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .paso-item {
    padding: 12px 16px;
    border-radius: 8px;
    background: white;
    border-left: 4px solid #667eea;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Courier New', monospace;
    animation: slideInLeft 0.4s ease;
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .paso-item.inicial-paso {
    background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
    border-left-color: #4caf50;
