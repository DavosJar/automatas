---
interface Props {
  tipo: string;
  nombre: string;
  ejemplos: Array<{nombre: string; simbolos: string[]; esperado: boolean}>;
}

const { tipo, nombre, ejemplos } = Astro.props;
---

<div class="card">
  <div class="ejemplos">
    <h3>Casos de Prueba</h3>
    <div class="ejemplos-grid">
      {ejemplos.map((ej) => (
        <button 
          class={`ejemplo-btn ${ej.esperado ? 'aceptacion' : 'rechazo'}`}
          data-tipo={tipo}
          data-simbolos={ej.simbolos.join(',')}
          data-nombre={ej.nombre}
        >
          <span class="icon">{ej.esperado ? '✅' : '❌'}</span>
          <span class="label">{ej.nombre}</span>
        </button>
      ))}
    </div>
  </div>
  
  <div class="custom">
    <h3>Validación Personalizada</h3>
    <form id={`form-${tipo}`} class="form">
      <input
        type="text"
        id={`input-${tipo}`}
        placeholder="Ej: SYN,ACK,RST"
        required
      />
      <button type="submit">Validar</button>
    </form>
  </div>
  
  <div id={`resultado-${tipo}`} class="resultado"></div>
</div>

<style>
  .card {
    background: white;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
  }
  
  h3 {
    color: #2c3e50;
    margin-bottom: 20px;
    font-size: 1.2rem;
  }
  
  .ejemplos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
    margin-bottom: 30px;
  }
  
  .ejemplo-btn {
    padding: 14px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    background: #f8f9fa;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    font-size: 0.9rem;
  }
  
  .ejemplo-btn.aceptacion {
    border-color: #4caf50;
    background: #e8f5e9;
    color: #2e7d32;
  }
  
  .ejemplo-btn.rechazo {
    border-color: #f44336;
    background: #ffebee;
    color: #c62828;
  }
  
  .ejemplo-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }
  
  .icon {
    font-size: 1.6rem;
  }
  
  .custom {
    margin-bottom: 30px;
  }
  
  .form {
    display: flex;
    gap: 10px;
  }
  
  input {
    flex: 1;
    padding: 12px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    font-size: 1rem;
    transition: all 0.3s;
  }
  
  input:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
  }
  
  .form button {
    padding: 12px 25px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    white-space: nowrap;
  }
  
  .form button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
  }
  
  .resultado {
    min-height: 200px;
  }
</style>

<script define:vars={{ tipo }}>
  const form = document.getElementById(`form-${tipo}`);
  const resultadoDiv = document.getElementById(`resultado-${tipo}`);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById(`input-${tipo}`);
    const simbolos = input.value.split(',').map(s => s.trim()).filter(s => s);
    if (simbolos.length === 0) {
      resultadoDiv.innerHTML = '<div class="error-msg">❌ Ingresa símbolos válidos</div>';
      return;
    }
    await validar(simbolos, input.value);
  });

  document.querySelectorAll(`.ejemplo-btn[data-tipo="${tipo}"]`).forEach(btn => {
    btn.addEventListener('click', async () => {
      const simbolos = btn.dataset.simbolos.split(',');
      await validar(simbolos, btn.dataset.nombre);
    });
  });

  async function validar(simbolos, label) {
    resultadoDiv.innerHTML = '<div class="loading">⏳ Validando...</div>';
    try {
      const response = await fetch(`http://localhost:8080/api/automatas/${tipo}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(simbolos)
      });
      if (!response.ok) throw new Error(`Error ${response.status}`);
      const data = await response.json();
      mostrar(data, label, simbolos);
    } catch (error) {
      resultadoDiv.innerHTML = `<div class="error-msg">❌ ${error.message}</div>`;
    }
  }

  function mostrar(data, label, simbolos) {
    const cadena = simbolos.join(' → ');
    const coinciden = data.validoAFN === data.validoAFDTransformado && data.validoAFDTransformado === data.validoAFDMinimizado;
    
    const html = `
      <div class="resultado-content">
        <div class="cadena-info">
          <h4>Cadena Validada</h4>
          <p class="cadena">${cadena}</p>
          <p class="label">${label}</p>
        </div>
        
        <div class="validaciones">
          <div class="val-item ${data.validoAFN ? 'valido' : 'invalido'}">
            <span class="icon">${data.validoAFN ? '✅' : '❌'}</span>
            <div><strong>AFN</strong><span>${data.validoAFN ? 'Aceptada' : 'Rechazada'}</span></div>
          </div>
          <div class="val-item ${data.validoAFDTransformado ? 'valido' : 'invalido'}">
            <span class="icon">${data.validoAFDTransformado ? '✅' : '❌'}</span>
            <div><strong>AFD Transform.</strong><span>${data.validoAFDTransformado ? 'Aceptada' : 'Rechazada'}</span></div>
          </div>
          <div class="val-item ${data.validoAFDMinimizado ? 'valido' : 'invalido'}">
            <span class="icon">${data.validoAFDMinimizado ? '✅' : '❌'}</span>
            <div><strong>AFD Minimizado</strong><span>${data.validoAFDMinimizado ? 'Aceptada' : 'Rechazada'}</span></div>
          </div>
        </div>
        
        <div class="consistency ${coinciden ? 'ok' : 'warning'}">
          ${coinciden ? '✓ Todos coinciden' : '⚠ Inconsistencia'}
        </div>
        
        <div class="tablas">
          ${tabla(data.afn, 'AFN')}
          ${tabla(data.afdTransformado, 'AFD Transform.')}
          ${tabla(data.afdMinimizado, 'AFD Minimizado')}
        </div>
      </div>
    `;
    resultadoDiv.innerHTML = html;
  }

  function tabla(aut, nombre) {
    const rows = Object.entries(aut.tablaTransiciones)
      .map(([e, t]) => `<tr><td>${e}</td><td>${Object.entries(t).map(([s, d]) => `<span>${s}→${d}</span>`).join('')}</td></tr>`)
      .join('');
    const aceptacion = aut.estadosAceptacion.size > 0 ? Array.from(aut.estadosAceptacion).join(', ') : '-';
    return `
      <div class="tabla-wrapper">
        <h4>${nombre}</h4>
        <div class="meta"><span>🎯 ${aut.estados.size} estados</span><span>▶️ ${aut.estadoInicial}</span><span>✓ ${aceptacion}</span></div>
        <table><thead><tr><th>Estado</th><th>Transiciones</th></tr></thead><tbody>${rows}</tbody></table>
      </div>
    `;
  }
</script>

<style>
  .resultado-content { animation: slideIn 0.3s ease; }
  @keyframes slideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  
  .loading, .error-msg {
    text-align: center;
    padding: 30px;
    font-weight: 500;
    border-radius: 8px;
  }
  
  .loading { color: #667eea; }
  .error-msg { background: #ffebee; color: #c62828; border-left: 4px solid #f44336; }
  
  .cadena-info {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 20px;
  }
  
  .cadena-info h4 { margin: 0 0 10px 0; opacity: 0.9; }
  .cadena { font-family: monospace; font-size: 1.1rem; margin: 10px 0; word-break: break-all; }
  .cadena-info .label { margin: 10px 0 0 0; font-size: 0.9rem; opacity: 0.8; }
  
  .validaciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 15px;
    margin-bottom: 20px;
  }
  
  .val-item {
    padding: 15px;
    border-radius: 8px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  
  .val-item.valido { background: #e8f5e9; border: 2px solid #4caf50; }
  .val-item.invalido { background: #ffebee; border: 2px solid #f44336; }
  .val-item .icon { font-size: 1.8rem; flex-shrink: 0; }
  .val-item div { display: flex; flex-direction: column; gap: 4px; }
  .val-item strong { color: #333; font-size: 0.95rem; }
  .val-item span { color: #666; font-size: 0.85rem; }
  
  .consistency {
    padding: 12px;
    border-radius: 8px;
    font-weight: 600;
    margin-bottom: 20px;
    text-align: center;
  }
  
  .consistency.ok { background: #e8f5e9; color: #2e7d32; border-left: 4px solid #4caf50; }
  .consistency.warning { background: #fff3e0; color: #e65100; border-left: 4px solid #ff9800; }
  
  .tablas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 20px;
  }
  
  .tabla-wrapper {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
  }
  
  .tabla-wrapper h4 { color: #2c3e50; margin: 0 0 10px 0; font-size: 1rem; }
  .meta { display: flex; gap: 15px; margin-bottom: 12px; font-size: 0.85rem; color: #666; flex-wrap: wrap; }
  .meta span code { background: #fff; padding: 2px 6px; border-radius: 4px; font-family: monospace; color: #d63031; }
  
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th { background: #667eea; color: white; padding: 10px; text-align: left; font-weight: 600; }
  td { padding: 10px; border-bottom: 1px solid #e0e0e0; }
  tr:hover { background: #f0f0f0; }
  span { background: #e8eaf6; padding: 3px 8px; border-radius: 4px; margin-right: 6px; display: inline-block; margin-bottom: 4px; font-family: monospace; font-size: 0.85rem; }
</style>
