---
import Layout from '../layouts/Layout.astro';
import ValidadorReact from '../components/ValidadorReact.jsx';

const ejemplos = [
  { nombre: 'Flujo básico',          simbolos: ['HOME', 'SEARCH', 'CART'],                          esperado: true  },
  { nombre: 'Búsqueda múltiple',     simbolos: ['HOME', 'SEARCH', 'SEARCH', 'CART'],                esperado: true  },
  { nombre: 'Volver a inicio',       simbolos: ['HOME', 'HOME', 'SEARCH', 'CART'],                  esperado: true  },
  { nombre: 'Varios ítems',          simbolos: ['HOME', 'SEARCH', 'CART', 'SEARCH', 'CART'],        esperado: true  },
  { nombre: 'Sin HOME',              simbolos: ['SEARCH', 'CART'],                                  esperado: false },
  { nombre: 'Sin SEARCH',            simbolos: ['HOME', 'CART'],                                    esperado: false },
  { nombre: 'Orden invertido',       simbolos: ['CART', 'SEARCH', 'HOME'],                          esperado: false },
  { nombre: 'Sin CART',              simbolos: ['HOME', 'SEARCH'],                                  esperado: false },
];
---

<Layout title="E-commerce">
  <h1>E-commerce - Flujo de Compra</h1>
  
  <ValidadorReact tipo="ecommerce" nombre="E-commerce" ejemplos={ejemplos} client:load />
</Layout>
