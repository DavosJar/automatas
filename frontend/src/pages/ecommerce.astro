---
import Layout from '../layouts/Layout.astro';
import ValidadorReact from '../components/ValidadorReact.jsx';

const ejemplos = [
  { nombre: 'Compra simple', simbolos: ['LOGIN', 'BROWSE', 'BUY', 'PAY', 'LOGOUT'], esperado: true },
  { nombre: 'Múltiples compras', simbolos: ['LOGIN', 'BROWSE', 'BUY', 'BROWSE', 'BUY', 'PAY', 'LOGOUT'], esperado: true },
  { nombre: 'Con carrito', simbolos: ['LOGIN', 'BROWSE', 'CART', 'BUY', 'PAY', 'LOGOUT'], esperado: true },
  { nombre: 'Más navegación', simbolos: ['LOGIN', 'BROWSE', 'BROWSE', 'BUY', 'PAY', 'LOGOUT'], esperado: true },
  { nombre: 'Sin login', simbolos: ['BROWSE', 'BUY', 'PAY', 'LOGOUT'], esperado: false },
  { nombre: 'Sin logout', simbolos: ['LOGIN', 'BROWSE', 'BUY', 'PAY'], esperado: false },
  { nombre: 'Pagar sin comprar', simbolos: ['LOGIN', 'BROWSE', 'PAY', 'LOGOUT'], esperado: false },
  { nombre: 'Orden invertida', simbolos: ['LOGOUT', 'PAY', 'BUY', 'BROWSE', 'LOGIN'], esperado: false },
];
---

<Layout title="E-commerce">
  <h1>E-commerce - Flujo de Compra</h1>
  
  <div class="page-intro">
    <p>Valida el flujo completo de una transacción de compra en línea. Los estados y transiciones se cargan dinámicamente del backend.</p>
  </div>
  
  <ValidadorReact tipo="ecommerce" nombre="E-commerce" ejemplos={ejemplos} client:load />
</Layout>
