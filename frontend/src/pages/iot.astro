---
import Layout from '../layouts/Layout.astro';
import ValidadorReact from '../components/ValidadorReact.jsx';

const ejemplos = [
  { nombre: 'Básico', simbolos: ['HDR', 'CRC'], esperado: true },
  { nombre: 'Con datos', simbolos: ['HDR', 'DATA', 'CRC'], esperado: true },
  { nombre: 'Múltiples datos', simbolos: ['HDR', 'DATA', 'DATA', 'CRC'], esperado: true },
  { nombre: '5 segmentos', simbolos: ['HDR', 'DATA', 'DATA', 'DATA', 'DATA', 'CRC'], esperado: true },
  { nombre: '10 segmentos', simbolos: ['HDR', 'DATA', 'DATA', 'DATA', 'DATA', 'DATA', 'DATA', 'DATA', 'DATA', 'DATA', 'CRC'], esperado: true },
  { nombre: 'Sin cabecera', simbolos: ['DATA', 'CRC'], esperado: false },
  { nombre: 'Sin CRC', simbolos: ['HDR', 'DATA'], esperado: false },
  { nombre: 'CRC primero', simbolos: ['CRC', 'HDR'], esperado: false },
];
---

<Layout title="Lecturas IoT">
  <h1>Lecturas IoT - HDR-CRC</h1>
  
  <ValidadorReact tipo="iot" nombre="Lecturas IoT" ejemplos={ejemplos} client:load />
</Layout>
