---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Validador de Autómatas Finitos">
  <h1>Validador de Autómatas Finitos</h1>
  
  <div class="page-intro">
    Selecciona un autómata para validar cadenas contra AFN, AFD transformado y AFD minimizado. Los estados y transiciones se cargan dinámicamente del backend.
  </div>
  
  <div class="cards-grid">
    <a href="/ciberseguridad" class="home-card ciber">
      <div class="card-icon">🔐</div>
      <h2>Ciberseguridad</h2>
      <p>TCP 3-way Handshake</p>
    </a>
    
    <a href="/iot" class="home-card iot">
      <div class="card-icon">📡</div>
      <h2>Lecturas IoT</h2>
      <p>Protocolo HDR-CRC</p>
    </a>
    
    <a href="/ecommerce" class="home-card ecom">
      <div class="card-icon">🛒</div>
      <h2>E-commerce</h2>
      <p>Flujo de Compra</p>
    </a>
  </div>
</Layout>

<style>
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  
  .home-card {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 32px 24px;
    text-decoration: none;
    color: #e0e0e0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    transition: all 0.3s;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 12px;
    backdrop-filter: blur(10px);
  }
  
  .home-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(102, 126, 234, 0.3);
    border-color: rgba(102, 126, 234, 0.4);
    color: white;
  }
  
  .card-icon {
    font-size: 2.5rem;
    margin-bottom: 8px;
  }
  
  .home-card.ciber { border-top: 3px solid #f44336; }
  .home-card.iot { border-top: 3px solid #2196f3; }
  .home-card.ecom { border-top: 3px solid #ff9800; }
  
  .home-card h2 {
    font-size: 1.4rem;
    color: white;
    margin: 0;
  }
  
  .home-card p {
    color: #a0a0b8;
    font-size: 0.95rem;
    margin: 0;
  }
</style>
